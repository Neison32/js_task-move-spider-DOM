"use strict";
document.addEventListener("click", function(e) {
    // write code here
    if (e.target.closest(".wall")) {
        var wall = document.querySelector(".wall");
        var spider = document.querySelector(".spider");
        var wallPosition = wall.getBoundingClientRect();
        var clickX = e.clientX;
        var clickY = e.clientY;
        var distanceX = clickX - wallPosition.left - wall.clientLeft;
        var distanceY = clickY - wallPosition.top - wall.clientTop;
        distanceX -= spider.clientWidth / 2;
        distanceY -= spider.clientHeight / 2;
        var allowedX = Math.min(Math.max(distanceX, 0), wall.clientWidth - spider.clientWidth);
        var allowedY = Math.min(Math.max(distanceY, 0), wall.clientHeight - spider.clientHeight);
        distanceX = allowedX;
        distanceY = allowedY;
        spider.style.left = "".concat(distanceX, "px");
        spider.style.top = "".concat(distanceY, "px");
    }
});

